#cloud-config
hostname: ${hostname}

# Вход только по ключу и только под созданным пользователем.
ssh_pwauth: false
disable_root: true

users:
  - name: ${login}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key_yaml}

# Запас на пики: на сервере 4 ГБ памяти.
swap:
  filename: /swapfile
  size: 1G

# Пакеты ставятся командой с ожиданием блокировки и повторами, а не модулем packages:
# при первом запуске менеджер пакетов занят фоновым обновлением системы, и модуль
# сдаётся через тридцать секунд.
runcmd:
  - - bash
    - -c
    - |
      export DEBIAN_FRONTEND=noninteractive
      for attempt in 1 2 3 4 5 6; do
        apt-get -o DPkg::Lock::Timeout=300 update \
          && apt-get -o DPkg::Lock::Timeout=300 install -y docker.io docker-compose-v2 make git \
          && exit 0
        sleep 20
      done
      exit 1
  - systemctl enable --now docker
  - usermod -aG docker ${login}
