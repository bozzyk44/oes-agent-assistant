# Обратный прокси стенда: страница и API ассистента по имени и по HTTPS.
# Сертификат Let's Encrypt Caddy получает и продлевает сам. Имя, пользователь и хэш пароля —
# из окружения контейнера; хэш считает команда запуска в compose.yaml из PROXY_PASSWORD.
# У сервиса нет аутентификации, X-User-ID доверенный, поэтому к сервису без пароля прокси не
# пускает. Исключение — Grafana со своим входом; новый маршрут без пароля — только так же явно.
{$STAND_DOMAIN} {
	# Grafana наблюдаемости — по пути /grafana/, со своим входом, без пароля прокси
	# (решение 24): окно пароля прокси и вход Grafana в одном браузере друг другу мешали.
	# Без профиля observability контейнера lgtm нет, и прокси отвечает 502.
	# Заголовок с паролем прокси, который браузер помнит для имени, в Grafana не уходит.
	handle /grafana {
		redir * /grafana/
	}
	handle /grafana/* {
		reverse_proxy lgtm:3000 {
			header_up -Authorization
		}
	}

	# Всё остальное — сервис, только с паролем прокси.
	handle {
		basic_auth {
			{$PROXY_USER} {$PROXY_PASSWORD_HASH}
		}
		reverse_proxy assistant:8000
	}
	# Браузер больше не ходит сюда по HTTP: ни cookie сессии Grafana, ни пароль прокси не
	# уходят открытым текстом до перенаправления на HTTPS.
	header Strict-Transport-Security "max-age=31536000"
	header -Server
}
