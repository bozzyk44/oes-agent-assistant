# Образец окружения. `make run` создаёт из него .env и заменяет каждую метку
# __GENERATE__ своим случайным значением. Настоящие секреты сюда не вписываются.

# --- Набор данных -----------------------------------------------------------
# Каталог на хосте; в контейнеры монтируется только на чтение.
DATA_DIR=data/

# --- Модель: любой OpenAI-совместимый API -----------------------------------
# Берутся и из этого файла, и из окружения оболочки (оболочка важнее).
# Модель на той же машине: http://host.docker.internal:<порт>/v1, не localhost.
# На Linux без Docker Desktop она должна слушать не только 127.0.0.1.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Необязательные настройки вызова; пусто — значения по умолчанию.
# Потолок выхода одного вызова (2048) и предел его времени в секундах (45). Модели
# с рассуждениями тратят выход и на них: оборванный по длине ответ итогом не считается.
MODEL_MAX_OUTPUT_TOKENS=
MODEL_TIMEOUT_SECONDS=
# Принуждение к формату JSON: last — только на последнем вызове хода, all — на всех, off.
MODEL_RESPONSE_FORMAT=
# Параметры провайдера сверх общего протокола, объект JSON: {"reasoning": {"enabled": false}}.
MODEL_EXTRA_BODY=
# Символов на токен по классам для оценки входа до вызова; пусто — умолчания с запасом:
# letters=3,digits=1,spaces=4,other=1.5. Поправка по фактическому расходу растёт сама.
MODEL_TOKEN_CHARS=
# GIT_COMMIT — коммит для GET /info; его задаёт make, в .env не нужен.

# Попыток каждого вопроса в прогоне; пусто — 3.
EVAL_ATTEMPTS=
# Цены для отчёта прогона, $ за 1 млн токенов.
PRICE_INPUT=
PRICE_CACHED=
PRICE_OUTPUT=
# LLM-судья (make judge-check, make judge) — другая модель, сильнее проверяемой. Адрес
# пуст — берутся адрес и ключ модели сервиса; свой адрес — только со своим ключом: ключ
# сервиса другому поставщику не уходит. Цены — $ за 1 млн токенов.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Добавка к телу запроса судьи, объект JSON; например {"reasoning": {"enabled": false}}.
JUDGE_EXTRA_BODY=
JUDGE_PRICE_INPUT=
JUDGE_PRICE_OUTPUT=

# --- ТОиР -------------------------------------------------------------------
TOIR_TOKEN=__GENERATE__
TOIR_URL=http://toir:8001

# --- PostgreSQL -------------------------------------------------------------
# Администратор сервера: только у шага ролей и баз. Владелец таблиц: только у шагов
# миграций и загрузки набора.
POSTGRES_PASSWORD=__GENERATE__
DATABASE_OWNER_URL=postgresql+psycopg://assistant_owner:__GENERATE__@postgres:5432/assistant
# Роль сервиса: без владения таблицами, под построчной защитой.
DATABASE_URL=postgresql+psycopg://assistant_app:__GENERATE__@postgres:5432/assistant
# Роль заглушки ТОиР: отдельная база на том же сервере.
TOIR_DATABASE_URL=postgresql+psycopg://toir_app:__GENERATE__@postgres:5432/toir
# Роль с обходом построчной защиты — только у мутантов (`make mutants`) в их отдельном
# проекте compose со своим томом; сервису этот адрес не передаётся.
BYPASS_DATABASE_URL=postgresql+psycopg://assistant_bypass:__GENERATE__@postgres:5432/assistant

# --- Публикация порта сервиса -----------------------------------------------
# У сервиса нет аутентификации: по умолчанию он слушает только локальный адрес.
SERVICE_BIND=127.0.0.1
SERVICE_PORT=8000

# --- Наблюдаемость (необязательно) ------------------------------------------
# Адрес приёмника OTLP по HTTP; пусто — телеметрия выключена. `make observe` задаёт
# http://lgtm:4318 сам и поднимает контейнер наблюдаемости.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Порт Grafana на локальном адресе хоста; пусто — 3000. Адрес — http://127.0.0.1:3000/grafana/.
GRAFANA_PORT=
# Внешний адрес Grafana для её ссылок; пусто — локальный. На стенде задаёт выкатка.
GRAFANA_ROOT_URL=
# Пароль пользователя admin в Grafana; на стенде сервер создаёт себе свой.
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# 1 — выкатка включает наблюдаемость на стенде и адрес приёмника для сервиса; Grafana там —
# https://<STAND_DOMAIN>/grafana/ под паролем прокси. Пусто — выкатка её выключает.
STAND_OBSERVABILITY=

# --- Прокси стенда (профиль proxy, необязательно) ---------------------------
# Имя, по которому стенд открывается по HTTPS, например oes-assistant.example.ru; пусто —
# прокси не нужен. Вход по паролю: у сервиса нет аутентификации.
STAND_DOMAIN=
PROXY_USER=demo
PROXY_PASSWORD=__GENERATE__
# Порты прокси на хосте; пусто — 80 и 443. Другие — только для проверки на своей машине.
PROXY_HTTP_PORT=
PROXY_HTTPS_PORT=

# --- Ход (необязательно) ----------------------------------------------------
# Пусто — умолчания сервиса: 4000 символов, 90 и 120 секунд.
# Предел длины сообщения пользователя; длиннее — 422.
MAX_MESSAGE_CHARS=
# Общий предел времени хода и срок отметки занятости сессии; первый обязан быть меньше.
TURN_TIMEOUT_SECONDS=
SESSION_LEASE_SECONDS=
