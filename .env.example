# Образец окружения. `make run` создаёт из него .env и заменяет каждую метку
# __GENERATE__ своим случайным значением. Настоящие секреты сюда не вписываются.

# --- Набор данных -----------------------------------------------------------
# Каталог на хосте; в контейнеры монтируется только на чтение.
DATA_DIR=data/

# --- Модель: любой OpenAI-совместимый API -----------------------------------
# Берутся и из этого файла, и из окружения оболочки (оболочка важнее).
# Модель на той же машине: http://host.docker.internal:<порт>/v1, не localhost.
# На Linux без Docker Desktop она должна слушать не только 127.0.0.1.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Цены для отчёта прогона, $ за 1 млн токенов.
PRICE_INPUT=
PRICE_CACHED=
PRICE_OUTPUT=

# --- ТОиР -------------------------------------------------------------------
TOIR_TOKEN=__GENERATE__
TOIR_URL=http://toir:8001

# --- PostgreSQL -------------------------------------------------------------
# Администратор сервера: только у шага ролей и баз. Владелец таблиц: только у шагов
# миграций и загрузки набора.
POSTGRES_PASSWORD=__GENERATE__
DATABASE_OWNER_URL=postgresql+psycopg://assistant_owner:__GENERATE__@postgres:5432/assistant
# Роль сервиса: без владения таблицами, под построчной защитой.
DATABASE_URL=postgresql+psycopg://assistant_app:__GENERATE__@postgres:5432/assistant
# Роль заглушки ТОиР: отдельная база на том же сервере.
TOIR_DATABASE_URL=postgresql+psycopg://toir_app:__GENERATE__@postgres:5432/toir

# --- Публикация порта сервиса -----------------------------------------------
# У сервиса нет аутентификации: по умолчанию он слушает только локальный адрес.
SERVICE_BIND=127.0.0.1
SERVICE_PORT=8000

# --- Наблюдаемость (необязательно) ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Ход (необязательно) ----------------------------------------------------
# Пусто — умолчания сервиса: 4000 символов, 90 и 120 секунд.
# Предел длины сообщения пользователя; длиннее — 422.
MAX_MESSAGE_CHARS=
# Общий предел времени хода и срок отметки занятости сессии; первый обязан быть меньше.
TURN_TIMEOUT_SECONDS=
SESSION_LEASE_SECONDS=
